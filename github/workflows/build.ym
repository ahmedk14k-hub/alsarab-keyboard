name: Build APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Locate project
        run: |
          if [ -f settings.gradle ]; then
            echo "PROJ=." >> "$GITHUB_ENV"
          else
            Z=$(ls ./*.zip 2>/dev/null | head -1 || true)
            if [ -n "$Z" ]; then mkdir -p _proj && unzip -q "$Z" -d _proj; fi
            S=$(find . -name settings.gradle -not -path './.git/*' | head -1)
            if [ -z "$S" ]; then echo "settings.gradle not found"; exit 1; fi
            echo "PROJ=$(dirname "$S")" >> "$GITHUB_ENV"
          fi

      - name: Build debug APK
        run: |
          cd "$PROJ"
          gradle assembleDebug --no-daemon --stacktrace
          mkdir -p "$GITHUB_WORKSPACE/out"
          cp app/build/outputs/apk/debug/*.apk "$GITHUB_WORKSPACE/out/Alsarab-Keyboard.apk"

      - uses: actions/upload-artifact@v4
        with:
          name: Alsarab-Keyboard-APK
          path: out/Alsarab-Keyboard.apk
